{
  "manifest_version": 3,
  "name": "Offline Course Exporter for UoPeople",
  "version": "1.0.0",
  "description": "Unofficial open-source study tool for University of the People students to export course materials into an offline website or Markdown files. Not affiliated with UoPeople or D2L.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://learn.uopeople.edu/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Offline Course Exporter for UoPeople",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://learn.uopeople.edu/*"],
      "js": ["zip_builder.js", "d2l_api.js", "html_builder.js", "markdown_builder.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
